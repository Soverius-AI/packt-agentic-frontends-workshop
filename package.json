{
  "name": "packt-agentic-frontends-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "Checkpoint 01: conventional facility application for the Packt Agentic Frontends workshop.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @packt-workshop/contracts test -- --run && pnpm --filter angular-host test --watch=false",
    "check": "pnpm build && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:angular": "pnpm --filter angular-host start",
    "dev:react": "pnpm --filter react-host dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
